# Serveur de modèles compatible OpenAI (Ollama par défaut, vLLM : http://localhost:8000/v1)
IACU_LLM_BASE_URL=http://localhost:11434/v1
IACU_LLM_API_KEY=ollama
# Réflexion des modèles à raisonnement : none (rapide), low, medium, high ; vide = défaut du modèle
IACU_LLM_REFLEXION=none
IACU_MODELE_CHAT=qwen3.5:9b
IACU_MODELE_GARDE=llama-guard3:8b
IACU_MODELE_EMBEDDINGS=qwen3-embedding:0.6b
# Juge (garde de sortie et évaluation) : de préférence un autre modèle que IACU_MODELE_CHAT
IACU_MODELE_JUGE=gemma4:12b

# Classifieur d'injection de prompt (modèle Hugging Face, groupe `gpu` requis). Vide : règles seules.
# Il signale sans bloquer, sauf si IACU_CLASSIFIEUR_INJECTION_BLOQUE=true (mesurer les faux positifs
# avant : voir src/exemplia/garde/README.md).
IACU_CLASSIFIEUR_INJECTION=
IACU_CLASSIFIEUR_INJECTION_SEUIL=0.8
IACU_CLASSIFIEUR_INJECTION_BLOQUE=false

IACU_DATABASE_URL=postgresql+psycopg://iacu:iacu@localhost:5432/entreprise
IACU_DATABASE_URL_LECTURE=postgresql+psycopg://lecteur:lecteur@localhost:5432/entreprise
IACU_QDRANT_URL=http://localhost:6333

# Dépôt du code, en lien dans le menu ; vide : pas de lien
IACU_DEPOT_URL=https://github.com/xavinsky/exemplia

IACU_MLFLOW_TRACKING_URI=http://localhost:5000
IACU_TRACAGE_ACTIF=true

# Exemple Vertex AI (authentification : gcloud auth application-default login)
IACU_GCP_PROJET=
IACU_GCP_REGION=europe-west1
IACU_MODELE_VERTEX=gemini-3.8-flash
